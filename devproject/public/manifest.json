{
  "manifest_version": 3,
  "name": "DevProject",
  "version": "0.1.0",
  "description": "A developer-learning browser extension.",
  "action": {
    "default_title": "DevProject"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel"],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ]
}